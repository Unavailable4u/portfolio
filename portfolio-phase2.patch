+    main.place(
+      ...(i > 0 ? [main.spacer(7)] : []),
+      main.text(e.degree, itemTitle),
+      main.dateLine([{ text: `${e.institution}  ·  ${e.location}` }], [{ text: e.dateRange }], meta, mono),
+    );
+  });
+
+  built.doc.end();
+  return built;
+}
